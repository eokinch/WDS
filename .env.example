# Notion integration token (secret — do not commit .env.local)
NOTION_API_KEY=

# Notion database IDs (from database URL: notion.so/.../<DATABASE_ID>?v=...)
NOTION_DB_PORTFOLIO=
NOTION_DB_CONTENT=

# Shared secret for webhook validation
# Must match the value configured in Notion workspace automations
NOTION_WEBHOOK_SECRET=

# Public domain for next/image remotePatterns (no https:// prefix)
# e.g. williams-design-studio.com
NEXT_PUBLIC_DOMAIN=
